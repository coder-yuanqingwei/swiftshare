<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  复制到: app/ios/SwiftShare/Info.plist
  仅列出需新增的 key，把它合并进现有 Info.plist 的 <dict> 内。
  完整接入步骤见 docs/NATIVE_SETUP.md

  v0.2 热点方案：已移除蓝牙相关 key，握手改用连接码复制/粘贴。
-->
<plist version="1.0">
<dict>
    <!-- ===== iOS 14+ 本地网络权限（个人热点 / 局域网传输必需） ===== -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>用于在局域网内高速传输图片文件</string>

    <!-- ===== 选图 / 相册 ===== -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>用于选择要发送的图片</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>用于保存接收到的图片到相册</string>

    <!--
      ⚠️ 关键：ATS 例外。Rust HTTP Server 在局域网用明文 HTTP（8787 端口），
      iOS ATS 默认禁止。NSAllowsLocalNetworking 仅放行本地网络明文，
      比 NSAllowsArbitraryLoads 更安全，App Store 审核可通过。
    -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
