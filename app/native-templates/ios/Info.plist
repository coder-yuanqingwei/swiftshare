<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  复制到: app/ios/SwiftShare/Info.plist
  仅列出需新增的 key，把它合并进现有 Info.plist 的 <dict> 内。
  完整接入步骤见 docs/NATIVE_SETUP.md
-->
<plist version="1.0">
<dict>
    <!-- ===== 蓝牙（Central 扫描 + Peripheral 广播双角色） ===== -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>用于发现附近设备并完成传输握手（仅交换几十字节信息，不通过蓝牙传文件）</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>用于让附近设备发现本机并建立传输握手</string>

    <!-- ===== iOS 14+ 本地网络权限（⚠️ 缺失会导致发现静默失败） ===== -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>用于在局域网内高速传输图片文件</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_swiftshare._tcp</string>
    </array>

    <!-- ===== 选图 / 相册 ===== -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>用于选择要发送的图片</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>用于保存接收到的图片到相册</string>

    <!--
      ⚠️ 关键：ATS 例外。Rust HTTP Server 在局域网用明文 HTTP（8787 端口），
      iOS ATS 默认禁止。NSAllowsLocalNetworking 仅放行本地网络明文，
      比 NSAllowsArbitraryLoads 更安全，App Store 审核可通过。
    -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>

    <!-- 后台蓝牙（ble-plx / peripheral-manager state restoration） -->
    <key>UIBackgroundModes</key>
    <array>
        <string>bluetooth-central</string>
        <string>bluetooth-peripheral</string>
    </array>
</dict>
</plist>
