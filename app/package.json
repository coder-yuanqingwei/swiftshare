{
  "name": "swiftshare",
  "version": "0.1.0",
  "private": true,
  "description": "Android <-> iOS photo/file transfer over BLE handshake + WiFi direct",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "typecheck": "tsc --noEmit",
    "ubrn:android": "ubrn build android --and-generate",
    "ubrn:ios": "ubrn build ios --and-generate"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-ble-plx": "^3.2.1",
    "react-native-ble-peripheral-manager": "^0.3.0",
    "react-native-qrcode-svg": "^6.3.2",
    "react-native-svg": "^15.8.0",
    "react-native-document-picker": "^9.3.1",
    "react-native-fs": "^2.20.0",
    "react-native-permissions": "^4.1.5",
    "@react-native-community/netinfo": "^11.3.3",
    "react-native-toast-message": "^2.2.0",
    "react-native-swiftshare-core": "file:../native-core"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "^18.3.12",
    "@types/react-native": "^0.73.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "typescript": "^5.7.2",
    "uniffi-bindgen-react-native": "^0.31.0",
    "@ubjs/core": "^0.31.0"
  }
}
